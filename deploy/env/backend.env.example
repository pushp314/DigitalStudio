APP_ENV=production
PORT=8090

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=bizcode_user
DB_PASSWORD=<generated>
DB_NAME=bizcode_prod
DATABASE_URL=postgres://bizcode_user:<generated>@localhost:5432/bizcode_prod?sslmode=disable

# Cache
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=<generate_secure_random>
SESSION_SECRET=<generate_secure_random>
LICENSE_SIGNING_KEY=<generate_secure_64_char_hex>

# URLs
FRONTEND_URL=https://bizcode.appnity.co.in
ALLOWED_ORIGINS=https://bizcode.appnity.co.in
COOKIE_SAMESITE=strict

# Toggles
ENABLE_SEEDER=false
ENABLE_AUTOMIGRATE=false

# Cloudflare R2 / Storage
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Email Delivery
EMAIL_PROVIDER=stdout
EMAIL_FROM=noreply@bizcode.appnity.co.in
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI Services
AI_API_KEY=ADD_YOUR_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_RPM=10

# External APIs
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://bizapi.appnity.co.in/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://bizapi.appnity.co.in/api/auth/github/callback
